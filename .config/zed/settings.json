// Zed settings
{
    "cli_default_open_behavior": "new_window",
    "agent_servers": {
        "github-copilot-cli": {
            "type": "registry"
        }
    },
    "restore_on_startup": "launchpad",
    "session": {
        "trust_all_worktrees": true
    },
    "project_panel": {
        "dock": "left"
    },
    "outline_panel": {
        "dock": "left"
    },
    "git_panel": {
        "dock": "left"
    },
    "disable_ai": true,
    "helix_mode": false,
    "minimap": {
        "show": "always"
    },
    "tab_size": 4,
    "linked_edits": false,
    "inline_code_actions": false,
    "current_line_highlight": "none",
    "rounded_selection": false,
    "selection_highlight": false,
    "cursor_shape": "bar",
    "agent": {
        "dock": "right",
        "default_model": {
            "effort": "high",
            "enable_thinking": true,
            "provider": "copilot_chat",
            "model": "gpt-5-mini"
        },
        "model_parameters": []
    },
    "language_models": {
        "ollama": {
            "api_url": "http://localhost:11434"
        },
        "open_router": {
            "available_models": [
                {
                    "name": "stepfun/step-3.5-flash:free",
                    "display_name": "Step 3.5 Flash (free)",
                    "max_tokens": 262144
                }
            ]
        }
    },
    "edit_predictions": {
        "ollama": {
            "prompt_format": "qwen",
            "model": "tinyllama:latest"
        },
        "provider": "zed",
        "open_ai_compatible_api": {
            "api_url": "https://openrouter.ai/api/v1/chat/completions",
            "model": "qwen/qwen3-coder:free",
            "prompt_format": "qwen",
            "max_output_tokens": 65536
        }
    },
    "vim_mode": false,
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "base_keymap": "VSCode",
    "buffer_font_family": "MesloLGL Nerd Font",
    "ui_font_family": "MesloLGS Nerd Font Mono",
    "buffer_font_size": 14,
    "ui_font_size": 14,
    "theme": {
        "mode": "dark",
        "light": "Tokyo Night Light",
        "dark": "Gruvbox Material"
    },
    "soft_wrap": "editor_width",
    "hover_popover_enabled": true,
    "hover_popover_delay": 300,
    "use_system_path_prompts": false,
    "use_system_prompts": false,
    "show_completions_on_input": true,
    "show_completion_documentation": false,
    "show_edit_predictions": true,
    "format_on_save": "on",
    "formatter": "language_server",
    "auto_signature_help": false,
    "show_signature_help_after_edits": false,
    "toolbar": {
        "agent_review": false,
        "breadcrumbs": true,
        "quick_actions": false,
        "selections_menu": false
    },
    "scrollbar": {
        "selected_symbol": false,
        "selected_text": false,
        "show": "auto",
        "diagnostics": "error"
    },
    "search": {
        "regex": true
    },
    "remove_trailing_whitespace_on_save": false,
    "ensure_final_newline_on_save": true,
    "inlay_hints": {
        "show_value_hints": false,
        "enabled": false
    },
    "collaboration_panel": {
        "dock": "left",
        "button": false
    },
    "notification_panel": {
        "button": false
    },
    "auto_update": true,
    "terminal": {
        "env": {
            "TERM_PROGRAM": "zed"
        },
        "toolbar": {
            "breadcrumbs": false
        }
    },
    "languages": {
        "Python": {
            "show_edit_predictions": false,
            "language_servers": [
                "!pyright",
                "ruff"
            ]
        }
    }
}
